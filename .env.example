# Carepool configuration. Copy to .env.local to change anything; every value has a working default.
# There is no API key: the real provider is the Claude Code CLI already signed in on this computer.

# claude-cli (default): each model step is one local `claude -p` call.
# mock: a scripted writer for tests and offline demos (every page shows a MOCK MODE banner).
CAREPOOL_PROVIDER=claude-cli
# Model aliases passed to `claude --model`.
CAREPOOL_MODEL_WRITER=sonnet
CAREPOOL_MODEL_REVIEW=opus
REVIEW_ENABLED=true
# Rounds in which failed sentences go back to the model before they are removed (0-3).
MAX_REPAIR_ROUNDS=1
# Model calls at once.
CARD_CONCURRENCY=2
# Seconds are long on a busy machine; a call is killed after this many milliseconds.
CLAUDE_CLI_TIMEOUT_MS=600000
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude

DATABASE_PATH=./data/carepool.db
# 1 = never call openFDA; use only data/label-cache/ (the demo medicines are all cached).
CAREPOOL_OFFLINE=0
