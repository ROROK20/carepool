{
  "name": "carepool",
  "version": "0.1.0",
  "private": true,
  "description": "A family care coordinator: plain-language medication cards in which every sentence quotes the FDA label, label-stated interaction flags, a schedule built only from what you typed, and a care circle that shares the work.",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3300}",
    "build": "next build",
    "start": "next start -p ${PORT:-3300}",
    "setup": "tsx scripts/setup.ts",
    "labels": "tsx scripts/fetch-labels.ts",
    "live": "tsx scripts/live-run.ts",
    "eval": "tsx scripts/eval.ts",
    "truth:check": "CAREPOOL_OFFLINE=1 tsx scripts/check-truth.ts",
    "screens": "tsx scripts/screens.ts",
    "record": "tsx scripts/record-demo.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
